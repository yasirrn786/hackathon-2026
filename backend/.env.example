# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

PORT=5000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dayflow_db
# Set to "true" only if your database requires SSL (e.g. some managed
# Postgres providers). Leave unset/false for local development.
DATABASE_SSL=false

# REQUIRED. The server will refuse to start without this. Must be at least
# 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login session stays valid.
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API, e.g.
#   FRONTEND_URL=http://127.0.0.1:5500,https://your-deployed-frontend.example.com
# Required in production. If left empty in development, CORS is left open
# so you can test with a local static file server.
FRONTEND_URL=

# bcrypt cost factor for password hashing.
BCRYPT_SALT_ROUNDS=12

NODE_ENV=development
